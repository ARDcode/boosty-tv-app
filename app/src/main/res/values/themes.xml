<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A plain dark theme. Compose supplies the real styling; this only needs
         to avoid a white flash between process start and first frame, which on
         a TV in a dark room is genuinely unpleasant. -->
    <style name="Theme.BoostyTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:colorAccent">@color/boosty_accent</item>
        <item name="android:textColorPrimary">@color/boosty_text</item>
        <item name="android:textColorSecondary">@color/boosty_text_secondary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
